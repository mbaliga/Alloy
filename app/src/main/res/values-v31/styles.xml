<resources>
    <!-- API 31+: use the platform SplashScreen attributes instead of the windowBackground
         trick. windowSplashScreenAnimatedIcon is left unset so the system falls back to the
         app's own adaptive launcher icon, which already carries the alloy wordmark. -->
    <style name="Theme.Alloy.Starting" parent="AppTheme">
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
