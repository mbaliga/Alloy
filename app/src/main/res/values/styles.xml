<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#E8B86A</item>
        <item name="android:navigationBarColor">#101820</item>
        <item name="android:statusBarColor">#101820</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Launch/splash theme: shows the alloy wordmark on black while the window spins up.
         MainActivity.onCreate() swaps back to AppTheme before inflating any content. -->
    <style name="Theme.Alloy.Starting" parent="AppTheme">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>
