 "cases": [
  {
   "id": "cantilever-tip-deflection",
   "title": "Cantilever, 80 x 10 x 10 mm steel, 10 N at the free end, voxel size 1 mm (10 voxels through the depth)",
   "reference": "Euler-Bernoulli (Gere and Goodno, Mechanics of Materials, table of beam deflections): delta = F L^3 / (3 E I) with F 10 N, L 80 mm, E 200000 MPa, I = w t^3 / 12 = 833.333 mm^4 gives 0.010240 mm; stiffness 3 E I / L^3 = 976.563 N/mm. The spec asks for within 3 % at fine; the run at the quality fine itself is in slow/structural-fine.json (npm run test:analysis:slow) because it needs about 250 000 voxels on the CPU. Timoshenko shear adds about 1.2 % to the true deflection of a beam this stocky, inside the tolerance.",
   "setup": {
    "features": [
     {
      "type": "box",
      "body": "Beam",
      "size": [
       80,
       10,
       10
      ],
      "anchor": "min",
      "pos": [
       0,
       0,
       0
      ]
     }
    ],
    "customMaterials": [
     {
      "id": "t-steel",
      "name": "Test steel",
      "class": "custom",
      "notes": "Validation test material.",
      "properties": {
       "k": {
        "value": 1,
        "quality": "measured",
        "sources": [
         "user"
        ]
       },
       "rho": {
        "value": 7800,
        "quality": "measured",
        "sources": [
         "user"
        ]
       },
       "cp": {
        "value": 500,
        "quality": "measured",
        "sources": [
         "user"
        ]
       },
       "emissivity": {
        "value": 0.9,
        "quality": "measured",
        "sources": [
         "user"
        ]
       },
       "E": {
        "value": 200000000000,
        "quality": "measured",
        "sources": [
         "user"
        ]
       },
       "nu": {
        "value": 0.3,
        "quality": "measured",
        "sources": [
         "user"
        ]
       },
       "yield_strength": {
        "value": 250000000,
        "quality": "measured",
        "sources": [
         "user"
        ]
       },
       "tensile_strength": {
        "value": 400000000,
        "quality": "measured",
        "sources": [
         "user"
        ]
       },
       "interlayer_factor": {
        "value": 1,
