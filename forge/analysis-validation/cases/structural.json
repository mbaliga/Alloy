    "customAssign": {
     "Beam": "t-steel"
    },
    "conditions": {
     "mounts": [
      {
       "id": "wall",
       "kind": "fixed",
       "body": "Beam",
       "face": "-x"
      }
     ],
     "loads": [
      {
       "id": "tip",
       "kind": "force",
       "body": "Beam",
       "face": "+x",
